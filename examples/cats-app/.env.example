PORT=3000
# Required, at least 32 bytes: the application refuses to start without it. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Optional, at least 32 bytes when set: the key of the services that call GET /api/v1/cats/export in the X-Api-Key
# header. Without it no key works. Generate one with: openssl rand -hex 32
# SERVICE_API_KEY=
# Optional HTTPS listener (build with `--features tls`). Paths to PEM files; never commit key material.
# CATS_TLS_CERT=
# CATS_TLS_KEY=
# CATS_TLS_PORT=3443
