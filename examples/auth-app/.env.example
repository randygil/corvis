# Configuration of auth-app without --dev. Nothing here has a working value: the application refuses to start until
# each variable is set, and a secret shorter than 32 bytes is refused too.
#
# Generate a secret with:  openssl rand -hex 32
# Load the file into the environment before running, for example:  set -a; . ./.env; set +a

# Sign the access tokens (15 minutes), the session cookie, the cookie that holds the state of an OAuth2 login, and
# the key that machine clients send in X-Api-Key. Four different values.
JWT_SECRET=
SESSION_SECRET=
OAUTH_STATE_SECRET=
SERVICE_API_KEY=

# The OAuth2 provider and the client registered with it. OAUTH_REDIRECT_URI is the absolute URL of
# GET /auth/provider/callback, exactly as registered with the provider (https, or http for a loopback host).
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# Behind a reverse proxy, the number of proxies (1) or a list of their addresses (loopback, 10.0.0.0/8). Without it every
# client has the proxy's address and shares one rate-limit counter.
# TRUST_PROXY=1

# Optional: the port, always on 127.0.0.1 (default 3000).
# PORT=3000
