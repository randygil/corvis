/** Todas las rutas del menú, en orden de lectura (las usa la comprobación de páginas). */
export function allLinks(items: Item[] = sidebar): string[] {
  return items.flatMap((i) => [...(i.link ? [i.link] : []), ...(i.items ? allLinks(i.items) : [])])
}
