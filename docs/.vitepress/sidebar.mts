import type { DefaultTheme } from 'vitepress'

type Item = DefaultTheme.SidebarItem

const group = (text: string, items: [string, string][], collapsed = true): Item => ({
  text,
  collapsed,
  items: items.map(([label, link]) => ({ text: label, link })),
})

