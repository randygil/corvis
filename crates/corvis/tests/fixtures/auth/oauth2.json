  "outcomes": [
    {
      "name": "success",
      "config": "google",
      "query": "code=ok&state=<state>",
      "status": 200,
      "token_requests": 1
    },
    {
      "name": "access_denied",
      "config": "google",
      "query": "error=access_denied&error_description=denied&state=<state>",
      "status": 401,
      "token_requests": 0
    },
    {
      "name": "other_provider_error",
      "config": "google",
      "query": "error=server_error&error_description=boom&state=<state>",
      "status": 502,
      "token_requests": 0,
      "divergence": "Corvis answers 401 for a provider error other than access_denied: it is caused by the request, not by the server (auth/oauth2: Request-caused callback failures are answered 401)"
    },
    {
      "name": "state_mismatch",
      "config": "google",
      "query": "code=ok&state=forged",
      "status": 403,
      "token_requests": 0,
      "note": "passport answers the status the strategy gave (403); the AuthGuard of Corvis answers 401 for every failed attempt"
    },
    {
      "name": "no_state",
      "config": "google",
      "query": "code=ok",
      "status": 403,
      "token_requests": 0
    },
    {
      "name": "token_400",
      "config": "google",
      "query": "code=badrequest&state=<state>",
      "status": 500,
      "token_requests": 1,
      "divergence": "Corvis answers 401 when the token endpoint rejects the code (400 or 401): the request caused it (a reused or forged code)"
    },
    {
      "name": "token_500",
      "config": "google",
      "query": "code=down&state=<state>",
      "status": 500,
      "token_requests": 1
    },
    {
      "name": "token_redirect",
      "config": "google",
      "query": "code=redirect&state=<state>",
      "status": 500,
      "token_requests": 1,
      "note": "node-oauth does not follow the redirect; the empty answer has no access token"
    },
    {
      "name": "token_garbage",
      "config": "google",
      "query": "code=garbage&state=<state>",
      "status": 500,
      "token_requests": 1
    },
    {
      "name": "token_without_access_token",
      "config": "google",
      "query": "code=noaccess&state=<state>",
      "status": 500,
      "token_requests": 1
    },
    {
      "name": "token_form_encoded",
      "config": "google",
      "query": "code=form&state=<state>",
      "status": 200,
      "token_requests": 1
    },
    {
      "name": "profile_500",
      "config": "google",
      "query": "code=profile500&state=<state>",
      "status": 500,
      "token_requests": 1
    },
    {
      "name": "validator_false",
