  "cases": [
    {
      "name": "json body",
      "request": {
        "method": "POST",
        "path": "/login",
        "headers": {
          "content-type": "application/json"
        },
        "body": "{\"username\":\"ana\",\"password\":\"secret\"}"
      },
      "response": {
        "status": 201,
        "body": {
          "user": {
            "username": "ana",
            "usernameType": "string",
            "password": "secret"
          }
        }
      },
      "divergence": null
    },
    {
      "name": "form body",
      "request": {
        "method": "POST",
        "path": "/login",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": "username=ana&password=secret"
      },
      "response": {
        "status": 201,
        "body": {
          "user": {
            "username": "ana",
            "usernameType": "string",
            "password": "secret"
          }
        }
      },
      "divergence": null
    },
    {
      "name": "form body with percent-encoding",
      "request": {
        "method": "POST",
        "path": "/login",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": "username=ana%40x.io&password=p%C3%A4ss+word%26"
      },
      "response": {
        "status": 201,
        "body": {
          "user": {
            "username": "ana@x.io",
            "usernameType": "string",
            "password": "päss word&"
          }
        }
      },
      "divergence": null
    },
    {
      "name": "query string only",
      "request": {
        "method": "POST",
        "path": "/login?username=ana&password=secret",
        "headers": {},
        "body": null
      },
      "response": {
        "status": 201,
        "body": {
          "user": {
            "username": "ana",
            "usernameType": "string",
            "password": "secret"
          }
        }
      },
      "divergence": "the original also reads credentials from the query string; Corvis does so only with allow_query_credentials() (URLs end up in logs), so by default the credential is missing"
    },
