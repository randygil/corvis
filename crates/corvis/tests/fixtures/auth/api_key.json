    {
      "name": "plus prefix, literal prefix",
      "request": {
        "method": "GET",
        "path": "/plus",
        "headers": {
          "x-key": "Key+test-key-000000000000000000000000000001"
        }
      },
      "response": {
        "status": 401,
        "body": {
          "message": "Unauthorized",
          "statusCode": 401
        }
      },
      "divergence": {
        "reason": "passport-headerapikey removes the prefix with an unescaped regular expression (`^Key+` removes only \"Key\", leaving \"+<key>\"); Corvis removes the literal prefix",
