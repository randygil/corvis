      "#[async_trait]",
      "impl CanActivate for ${3}Guard {",
      "    async fn can_activate(&self, ctx: &ExecutionContext) -> Result<bool, HttpException> {",
      "        let required: Option<Vec<String>> = self.reflector.get_all_and_override(${1}_KEY, &[ctx.get_handler(), ctx.get_class()]);",
      "        let Some(required) = required else { return Ok(true) };",
      "        let user = ctx.request().user_as::<${4:Value}>();",
      "        let role = user.as_ref().and_then(|u| u.get(\"${5:role}\")).and_then(Value::as_str);",
      "        Ok(role.is_some_and(|r| required.iter().any(|x| x == r)))",
      "    }",
      "}$0"
    ]
  },
